{
  "name": "tracepay",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:api": "npm run dev -w @tracepay/api",
    "dev:web": "npm run dev -w @tracepay/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "protobufjs": false,
    "@google/genai": false
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3"
  }
}
