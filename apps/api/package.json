{
  "name": "@tracepay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=../../.env.local src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "db:migrate": "DATABASE_URL=${LOCAL_DATABASE_URL:-postgresql://tracepay:tracepay@localhost:5433/tracepay} DATABASE_URL_UNPOOLED= prisma migrate dev",
    "db:deploy": "node scripts/migrate-deploy.mjs",
    "predb:seed": "prisma generate",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=../../.env.local src/scripts/seed.ts",
    "smoke:paypal": "tsx --env-file-if-exists=.env --env-file-if-exists=../../.env.local src/scripts/smoke-paypal.ts",
    "smoke:vertex": "tsx --env-file-if-exists=.env --env-file-if-exists=../../.env.local src/scripts/smoke-vertex.ts",
    "keys:generate": "tsx src/scripts/generate-signing-key.ts",
    "pretest:integration": "prisma generate",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://tracepay:tracepay@localhost:5433/tracepay_test} TEST_REDIS_URL=${TEST_REDIS_URL-redis://localhost:6380} vitest run",
    "test:coverage": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://tracepay:tracepay@localhost:5433/tracepay_test} TEST_REDIS_URL=${TEST_REDIS_URL-redis://localhost:6380} vitest run --coverage",
    "test:e2e": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://tracepay:tracepay@localhost:5433/tracepay_test} vitest run --config vitest.e2e.config.ts",
    "db:check-drift": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://tracepay:tracepay@localhost:5433/tracepay_test} DATABASE_URL_UNPOOLED= prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "test:live-ai": "LIVE_AI=1 TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://tracepay:tracepay@localhost:5433/tracepay_test} vitest run tests/live",
    "red-team": "tsx --env-file-if-exists=.env src/scripts/red-team.ts"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tracepay/shared": "*",
    "cors": "^2.8.5",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "^8.16.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "prisma": "7.10.1",
    "puppeteer-core": "25.16.0",
    "supertest": "^7.0.0",
    "tsup": "^8.5.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
