{
  "name": "@tracepay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "smoke:paypal": "tsx --env-file-if-exists=.env src/scripts/smoke-paypal.ts",
    "smoke:vertex": "tsx --env-file-if-exists=.env src/scripts/smoke-vertex.ts",
    "keys:generate": "tsx src/scripts/generate-signing-key.ts",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://tracepay:tracepay@localhost:5433/tracepay_test} vitest run"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tracepay/shared": "*",
    "cors": "^2.8.5",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "^8.16.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsup": "^8.5.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
