# Copy to apps/api/.env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
# Hackathon role switcher + demo reset. Must be false for real users.
DEMO_MODE=true
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=20
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# Proxies in front of the API: 1 for Render alone, 2 behind Vercel's /api rewrite
TRUST_PROXY_HOPS=1
SESSION_TTL_DAYS=14
LOG_LEVEL=info
# Local: the Docker database (npm run db:up).
# Neon: DATABASE_URL          = the POOLED connection string (host has "-pooler"),
#       DATABASE_URL_UNPOOLED = the direct string (pooling off), used only for migrations.
# `neon deploy` / `neon env pull` writes both to the repo-root .env.local, which the
# dev, seed and migrate commands load after this file (so Neon takes precedence).
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#   DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://tracepay:tracepay@localhost:5433/tracepay
DB_POOL_MAX=10
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173

# PayPal — SANDBOX ONLY (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created when you register the webhook URL (…/api/webhooks/paypal) in the dashboard
PAYPAL_WEBHOOK_ID=

# Vertex AI (Gemini)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# A Gemini model available to your project/region in Vertex AI Model Garden
VERTEX_MODEL=
# Optional locally (gcloud ADC is used instead). Required on Render: service-account JSON, raw or base64.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Ed25519 key for signing audit receipts: npm run keys:generate -w @tracepay/api
AUDIT_SIGNING_PRIVATE_KEY=

# Demo: comma-separated SANDBOX personal account emails for payable contributors
# (order: Northwind, Okafor, Lumen). Leave blank to use placeholder addresses.
DEMO_PAYEE_EMAILS=
