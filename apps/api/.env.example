# Copy to apps/api/.env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
# Hackathon role switcher + demo reset. Must be false for real users.
DEMO_MODE=true
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=20
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# Proxies in front of the API: 1 for Render alone, 2 behind Vercel's /api rewrite
TRUST_PROXY_HOPS=1
# Platform edge header with the visitor IP (Render: cf-connecting-ip; set automatically there)
CLIENT_IP_HEADER=
SESSION_TTL_DAYS=14
LOG_LEVEL=info
# Local: the Docker database (npm run db:up).
# Neon: DATABASE_URL          = the POOLED connection string (host has "-pooler"),
#       DATABASE_URL_UNPOOLED = the direct string (pooling off), used only for migrations.
# `neon deploy` / `neon env pull` writes both to the repo-root .env.local, which the
# dev, seed and migrate commands load after this file (so Neon takes precedence).
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#   DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://tracepay:tracepay@localhost:5433/tracepay
DB_POOL_MAX=10
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
# Production (Render): APP_BASE_URL=https://trace-pay-umber.vercel.app
#                     CORS_ORIGINS=https://trace-pay-umber.vercel.app

# PayPal — SANDBOX ONLY (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created when you register the webhook URL (…/api/webhooks/paypal) in the dashboard
PAYPAL_WEBHOOK_ID=
# Demo mode only: shown on the Store page so visitors know which SANDBOX buyer account to pay with,
# e.g. "Email: judge@personal.example.com · Password: …". Sandbox credentials only.
PAYPAL_SANDBOX_BUYER_HINT=

# AI (Gemini). Easiest: a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; defaults to gemini-flash-latest
GEMINI_MODEL=
# Or Vertex AI on Google Cloud (used instead of the API key when both are set)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# A Gemini model available to your project/region in Vertex AI Model Garden
VERTEX_MODEL=
# Optional locally (gcloud ADC is used instead). Required on Render: service-account JSON, raw or base64.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Shared with the web app's Vercel env TRACEPAY_PROXY_SECRET (32+ characters): lets the API
# trust the visitor IP Vercel forwards, for per-visitor rate limits. Optional.
TRUSTED_PROXY_SECRET=

# Platform API (/api/v1): requests per minute per API key (twice that per account)
API_RATE_LIMIT_PER_MINUTE=600
# Encrypts webhook signing secrets at rest: 32 random bytes, base64 or hex
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional (derived from AUDIT_SIGNING_PRIVATE_KEY otherwise). Changing it later is safe;
# list replaced keys in WEBHOOK_SECRET_KEY_PREVIOUS (comma-separated).
WEBHOOK_SECRET_KEY=
WEBHOOK_SECRET_KEY_PREVIOUS=
# Local development only: let webhooks reach http:// and private/loopback addresses
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Ed25519 key for signing audit receipts: npm run keys:generate -w @tracepay/api
AUDIT_SIGNING_PRIVATE_KEY=

# Demo: comma-separated SANDBOX personal account emails for payable contributors
# (order: Northwind, Okafor, Lumen). Leave blank to use placeholder addresses.
DEMO_PAYEE_EMAILS=

# ---- Shared rate limits -----------------------------------------------------------
# Redis / Render Key Value: limits and quotas hold across every API instance. Without it
# each instance counts in memory. `npm run db:up` starts one on :6380.
REDIS_URL=

# ---- AI ---------------------------------------------------------------------------
# auto (default: Gemini when configured, else the labeled fallbacks) | vertex | fixture
GENERATION_MODE=

# ---- Pay-per-citation answers -----------------------------------------------------
# The library's fee per answered question, in cents (default 2).
ANSWER_FEE_CENTS=
# Smallest royalty total worth one PayPal payout, in cents (default 100; 1 in demo mode).
ROYALTY_PAYOUT_MIN_CENTS=
# Days an earned credit waits before it can be paid out, so refunds and chargebacks land
# first and can claw it back (default 14; 0 in demo mode).
CREDIT_CLEARING_DAYS=
