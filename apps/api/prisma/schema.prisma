// TracePay data model.
// Principles: asset versions and approved terms are immutable once used;
// settlements snapshot the terms they apply; money is integer cents;
// every financial transition is idempotent and keyed on provider ids.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identities

enum Role {
  publisher
  contributor
  buyer
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role
  /// PayPal account that receives payouts (sandbox personal account in the demo).
  paypalEmail  String?
  /// scrypt hash; null for demo users who can only be reached via the demo role switcher.
  passwordHash String?
  createdAt    DateTime @default(now())

  sessions Session[]
  apiKeys  ApiKey[]

  idempotencyKeys  IdempotencyKey[]
  webhookEndpoints WebhookEndpoint[]

  assets       Asset[]
  licensesHeld LicenseGrant[] @relation("licensee")
  buildJobs    BuildJob[]
  agentRuns    AgentRun[]
  purchases    Sale[]

  creditAccount   CreditAccount?
  libraryAnswers  Answer[]         @relation("library")
  citationCredits CitationCredit[] @relation("creditContributor")
  royaltyPayouts  RoyaltyPayout[]
}

/// Server-side session. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?

  @@index([userId])
}

/// Programmatic access for platforms integrating TracePay. Only a hash is stored.
enum ApiKeyAccess {
  /// GET requests only.
  read_only
  read_write
}

model ApiKey {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// First characters of the key, shown so users can tell keys apart.
  prefix     String
  keyHash    String       @unique
  access     ApiKeyAccess @default(read_write)
  /// Null = never expires.
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

/// Replay protection for POSTs to the platform API (`Idempotency-Key` header).
/// A retried request with the same key and body gets the first response back
/// instead of being executed twice. Rows expire after 24 hours.
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key          String
  /// SHA-256 of method, path and canonical body: the same key with different input is refused.
  requestHash  String
  /// Null while the first request is still running.
  statusCode   Int?
  responseBody Json?
  lockedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

// ---------------------------------------------------------------- assets & licenses

enum AssetKind {
  dataset
  research_notes
  expert_brief
  api_feed
}

model Asset {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  title       String
  kind        AssetKind
  description String
  /// Hidden from the marketplace; existing licenses are unaffected.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  versions AssetVersion[]
  licenses LicenseGrant[]

  @@index([ownerId])
}

/// An immutable, fingerprinted snapshot of an asset's content.
model AssetVersion {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  version   Int
  sha256    String
  content   String
  createdAt DateTime @default(now())

  chunks       SourceChunk[]
  buildSources BuildSource[]

  @@unique([assetId, version])
}

model SourceChunk {
  id             String       @id @default(cuid())
  assetVersionId String
  assetVersion   AssetVersion @relation(fields: [assetVersionId], references: [id])
  ordinal        Int
  text           String
  /// Whether the passage tries to instruct AI systems (screened once; versions are immutable). Null: not screened yet.
  instructsAi    Boolean?
  /// Why, in plain words.
  screenNote     String?
  /// What screened it: the model's name, or "rules".
  screenedBy     String?

  events    SourceEvent[]
  citations ArtifactCitation[]

  @@unique([assetVersionId, ordinal])
}

/// Lifecycle of a two-party license:
///   requested (publisher asked) → offered (contributor set terms) → approved (publisher accepted)
///   offered → declined (publisher) | withdrawn (contributor)
///   approved → revoked (contributor; future builds only) | superseded (a newer version was accepted)
enum LicenseStatus {
  requested
  draft
  offered
  approved
  declined
  withdrawn
  revoked
  superseded
}

enum TermsOrigin {
  manual
  ai_draft
  rules_draft
}

/// A grant of rights from an asset owner to a licensee. Terms are frozen once
/// approved; editing creates a new version and supersedes the old one.
model LicenseGrant {
  id             String        @id @default(cuid())
  assetId        String
  asset          Asset         @relation(fields: [assetId], references: [id])
  licenseeId     String
  licensee       User          @relation("licensee", fields: [licenseeId], references: [id])
  version        Int
  status         LicenseStatus @default(draft)
  /// Normalized terms; null only while a publisher's request awaits the contributor's offer.
  terms          Json?
  termsHash      String?
  origin         TermsOrigin   @default(manual)
  /// Raw AI/rules extraction kept for comparison; never enforced.
  aiExtraction   Json?
  sourceText     String?
  /// The publisher's note when requesting a license.
  requestMessage String?
  /// Contributor (licensor) confirmed these exact terms.
  offeredAt      DateTime?
  /// Licensee accepted; the grant became enforceable.
  approvedAt     DateTime?
  approvedById   String?
  /// Who closed the grant (declined, withdrawn or revoked) and when.
  closedAt       DateTime?
  closedById     String?
  closedReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  buildSources BuildSource[]

  @@unique([assetId, licenseeId, version])
  @@index([assetId, licenseeId, status])
  @@index([licenseeId, status])
}

// ---------------------------------------------------------------- agent & builds

enum AgentRunStatus {
  running
  awaiting_approval
  completed
  failed
}

enum AgentRunKind {
  /// The Publisher Agent: builds a licensed report and lists it.
  publisher
  /// The Shopping Assistant: finds a report for a buyer, within their budget.
  buyer
}

model AgentRun {
  id          String         @id @default(cuid())
  kind        AgentRunKind   @default(publisher)
  /// The user the run works for: the publisher, or the buyer for a shopping run.
  publisherId String
  publisher   User           @relation(fields: [publisherId], references: [id])
  goal        String
  /// Publisher's pre-authorization, e.g. { autoReplace: true }.
  policy      Json
  status      AgentRunStatus @default(running)
  model       String?
  /// Initial build intent and source selection set by the publisher; the agent cannot change them.
  intent      Json
  selection   Json
  /// Provider-neutral conversation history, so a run paused for approval can resume.
  transcript  Json           @default("[]")
  /// The tool call waiting on a publisher decision, if any.
  pending     Json?
  summary     String?
  createdAt   DateTime       @default(now())
  /// Last activity; used to detect runs interrupted by a restart.
  updatedAt   DateTime       @default(now()) @updatedAt
  finishedAt  DateTime?

  steps  AgentStep[]
  builds BuildJob[]

  @@index([publisherId, kind, status])
}

enum AgentStepKind {
  plan
  tool_call
  tool_result
  approval_request
  message
  error
}

model AgentStep {
  id        String        @id @default(cuid())
  runId     String
  run       AgentRun      @relation(fields: [runId], references: [id])
  ordinal   Int
  kind      AgentStepKind
  tool      String?
  input     Json?
  output    Json?
  createdAt DateTime      @default(now())

  @@unique([runId, ordinal])
}

enum BuildStatus {
  preflight_blocked
  preflight_passed
  generating
  generated
  generation_failed
}

model BuildJob {
  id            String      @id @default(cuid())
  publisherId   String
  publisher     User        @relation(fields: [publisherId], references: [id])
  agentRunId    String?
  agentRun      AgentRun?   @relation(fields: [agentRunId], references: [id])
  intent        Json
  asOf          String
  status        BuildStatus
  preflight     Json
  policyVersion String
  /// sha256 of the frozen intent + terms; settlement must match it.
  snapshotHash  String
  createdAt     DateTime    @default(now())
  /// Last activity; used to detect generation interrupted by a restart.
  updatedAt     DateTime    @default(now()) @updatedAt

  sources  BuildSource[]
  events   SourceEvent[]
  artifact Artifact?

  @@index([publisherId, status])
}

/// A source pinned into a build, with the license terms frozen at that moment.
model BuildSource {
  id             String        @id @default(cuid())
  buildJobId     String
  buildJob       BuildJob      @relation(fields: [buildJobId], references: [id])
  /// Position in the publisher's selection; keeps reports and receipts deterministic.
  ordinal        Int           @default(0)
  assetVersionId String
  assetVersion   AssetVersion  @relation(fields: [assetVersionId], references: [id])
  licenseGrantId String?
  licenseGrant   LicenseGrant? @relation(fields: [licenseGrantId], references: [id])
  termsSnapshot  Json?
  payeeEmail     String?

  @@unique([buildJobId, assetVersionId])
  @@index([assetVersionId])
}

enum SourceEventType {
  retrieved
  cited
}

model SourceEvent {
  id             String          @id @default(cuid())
  buildJobId     String
  buildJob       BuildJob        @relation(fields: [buildJobId], references: [id])
  assetVersionId String
  chunkId        String
  chunk          SourceChunk     @relation(fields: [chunkId], references: [id])
  eventType      SourceEventType
  handle         String
  createdAt      DateTime        @default(now())

  @@index([buildJobId, eventType])
}

// ---------------------------------------------------------------- artifacts

enum ArtifactStatus {
  draft
  listed
  withdrawn
}

model Artifact {
  id             String         @id @default(cuid())
  buildJobId     String         @unique
  buildJob       BuildJob       @relation(fields: [buildJobId], references: [id])
  version        Int            @default(1)
  title          String
  /// { sections: [{ key, heading, body, requiresCitation }], credits: [...] }
  content        Json
  contentHash    String
  priceCents     Int
  currency       String         @default("USD")
  status         ArtifactStatus @default(draft)
  citationReport Json
  model          String
  /// true when content came from a labeled fixture instead of a live model call.
  fromFixture    Boolean        @default(false)
  createdAt      DateTime       @default(now())

  citations ArtifactCitation[]
  sales     Sale[]
}

model ArtifactCitation {
  id             String      @id @default(cuid())
  artifactId     String
  artifact       Artifact    @relation(fields: [artifactId], references: [id])
  sectionKey     String
  handle         String
  chunkId        String
  chunk          SourceChunk @relation(fields: [chunkId], references: [id])
  assetVersionId String

  @@unique([artifactId, sectionKey, chunkId])
}

// ---------------------------------------------------------------- sales & PayPal

enum SaleStatus {
  pending_payment
  captured
  payment_failed
  refunded
  exception
}

model Sale {
  id             String     @id @default(cuid())
  artifactId     String
  artifact       Artifact   @relation(fields: [artifactId], references: [id])
  buyerId        String?
  buyer          User?      @relation(fields: [buyerId], references: [id])
  amountCents    Int
  currency       String     @default("USD")
  status         SaleStatus @default(pending_payment)
  /// Rights re-checked when the buyer started checkout (licenses can be revoked or expire after a build).
  rightsCheck    Json?
  /// The license terms in force at the moment of sale; the settlement applies exactly these.
  termsSnapshot  Json?
  snapshotHash   String?
  /// The buyer already owned the report and deliberately bought it again (a hosted demo's shared buyer).
  repeatPurchase Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  payment    PayPalPayment?
  settlement SettlementRun?

  @@index([artifactId, buyerId, status])
  @@index([buyerId, status])
}

model PayPalPayment {
  id             String   @id @default(cuid())
  saleId         String   @unique
  sale           Sale     @relation(fields: [saleId], references: [id])
  orderId        String   @unique
  orderStatus    String
  captureId      String?  @unique
  captureStatus  String?
  capturedCents  Int?
  paypalFeeCents Int?
  payerEmail     String?
  rawCapture     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Reconciliation: when TracePay next asks PayPal about this payment (null = nothing left to check).
  nextCheckAt      DateTime?
  checkCount       Int       @default(0)
  lastCheckedAt    DateTime?
  /// Lease held by the worker checking it right now.
  checkLockedUntil DateTime?

  @@index([nextCheckAt])
}

/// Every PayPal webhook we receive, keyed by PayPal's event id for idempotency.
model WebhookEvent {
  id          String    @id
  eventType   String
  resourceId  String?
  verified    Boolean
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  outcome     String?
}

// ---------------------------------------------------------------- settlement & payouts

enum SettlementStatus {
  calculated
  approved
  payout_submitted
  completed
  exception
}

model SettlementRun {
  id                     String           @id @default(cuid())
  saleId                 String           @unique
  sale                   Sale             @relation(fields: [saleId], references: [id])
  snapshotHash           String
  grossCents             Int
  contributorTotalCents  Int
  publisherResidualCents Int
  roundingRule           String
  status                 SettlementStatus @default(calculated)
  approvedById           String?
  approvedAt             DateTime?
  /// Why the settlement could not be calculated (the capture is still recorded).
  failureReason          String?
  createdAt              DateTime         @default(now())

  lines   SettlementLine[]
  /// Payout attempts: 1 is the original batch; retries of failed items get 2, 3, ...
  batches PayoutBatch[]
}

enum SettlementLineKind {
  contributor
  publisher_residual
}

model SettlementLine {
  id             String             @id @default(cuid())
  runId          String
  run            SettlementRun      @relation(fields: [runId], references: [id])
  kind           SettlementLineKind
  recipientId    String
  payeeEmail     String?
  licenseGrantId String?
  assetVersionId String?
  amountCents    Int
  formula        String
  payable        Boolean
  note           String?

  payoutItem PayoutItem?

  @@index([runId])
}

model PayoutBatch {
  id            String        @id @default(cuid())
  runId         String
  run           SettlementRun @relation(fields: [runId], references: [id])
  attempt       Int           @default(1)
  /// Our idempotency key, reused verbatim on every retry.
  senderBatchId String        @unique
  paypalBatchId String?       @unique
  status        String
  lastResponse  Json?
  lastCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  /// When the current send to PayPal started (status SUBMITTING): how an interrupted send is recognised.
  sendingSince    DateTime?
  /// Reconciliation: when TracePay next asks PayPal about this batch (null = every payout is final).
  nextPollAt      DateTime?
  pollCount       Int       @default(0)
  /// Lease held by the worker polling it right now.
  pollLockedUntil DateTime?

  items PayoutItem[]

  @@unique([runId, attempt])
  @@index([nextPollAt])
}

model PayoutItem {
  id               String         @id @default(cuid())
  batchId          String
  batch            PayoutBatch    @relation(fields: [batchId], references: [id])
  settlementLineId String         @unique
  settlementLine   SettlementLine @relation(fields: [settlementLineId], references: [id])
  senderItemId     String         @unique
  paypalItemId     String?        @unique
  transactionId    String?
  receiver         String
  amountCents      Int
  status           String
  errorName        String?
  /// Earlier attempts for this line (batch, receiver, final status), newest last.
  attempts         Json           @default("[]")
  updatedAt        DateTime       @updatedAt

  @@index([batchId])
}

// ---------------------------------------------------------------- audit

/// Append-only, hash-chained history: hash = sha256(previousHash || canonical(entry)).
model AuditEvent {
  seq          Int      @id @default(autoincrement())
  entityType   String
  entityId     String
  eventType    String
  payload      Json
  /// Artifact this event belongs to, for building receipts.
  artifactId   String?
  /// Publisher whose data this event concerns (null = system). Used to scope views; not part of the hash.
  tenantId     String?
  previousHash String
  hash         String   @unique
  createdAt    DateTime @default(now())

  @@index([artifactId])
  @@index([entityType, entityId])
  @@index([tenantId, seq])
  @@index([eventType, seq])
}

// ---------------------------------------------------------------- platform API: outbound webhooks

enum WebhookEndpointStatus {
  enabled
  /// Paused by its owner, or automatically after failing for too long.
  disabled
}

/// A URL on the publisher's side that receives signed event notifications.
model WebhookEndpoint {
  id                    String                @id @default(cuid())
  ownerId               String
  owner                 User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url                   String
  description           String?
  /// Event types to send; ["*"] = all.
  enabledEvents         String[]
  status                WebhookEndpointStatus @default(enabled)
  disabledReason        String?
  /// Signing secret, AES-256-GCM encrypted (it must be recoverable to sign; it is never shown again).
  secretEnc             String
  /// After a rotation the old secret keeps signing (alongside the new one) until this time.
  previousSecretEnc     String?
  previousSecretExpires DateTime?
  consecutiveFailures   Int                   @default(0)
  /// First failure of the current failing streak; null while healthy.
  failingSince          DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  deliveries WebhookDelivery[]

  @@index([ownerId])
}

/// The public, versioned event log of one publisher. Written in the same transaction
/// as the audit event it reflects, so an event exists if and only if the change committed.
model OutboundEvent {
  id        String   @id
  ownerId   String
  type      String
  /// Thin payload: ids and a few curated fields. Full objects are fetched via the API.
  data      Json
  /// The audit-chain event this mirrors (null for webhook pings).
  auditSeq  Int?     @unique
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([ownerId, createdAt])
  @@index([createdAt])
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  /// Retries exhausted, or the receiver answered 410 Gone.
  failed
  /// Not attempted: the endpoint was disabled or deleted first.
  skipped
}

model WebhookDelivery {
  id             String                @id
  eventId        String
  event          OutboundEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status         WebhookDeliveryStatus @default(pending)
  /// Total attempts ever made (only goes up).
  attempts       Int                   @default(0)
  /// `attempts` when the current retry cycle began (a manual retry starts a fresh cycle).
  scheduleBase   Int                   @default(0)
  nextAttemptAt  DateTime?
  /// Lease: a worker that claimed this delivery owns it until then (crash-safe).
  lockedUntil    DateTime?
  lastAttemptAt  DateTime?
  lastStatusCode Int?
  lastError      String?
  /// Every attempt: [{ at, statusCode, error, durationMs }].
  history        Json                  @default("[]")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// ---------------------------------------------------------------- reconciliation

enum ReconciliationIssueStatus {
  open
  resolved
}

/// Something about money that needs a person: a refund made outside TracePay, a
/// payout PayPal couldn't deliver, a batch PayPal never confirmed… Opened by the
/// reconciliation worker (or by webhooks), resolved automatically when the cause
/// clears, or by the publisher with a note.
model ReconciliationIssue {
  id          String                    @id @default(cuid())
  /// The publisher who must act.
  ownerId     String
  /// Stable machine code, e.g. "sale_refunded", "payout_failed".
  kind        String
  subjectType String
  subjectId   String
  /// Plain-language summary and what to do.
  title       String
  detail      String
  data        Json                      @default("{}")
  status      ReconciliationIssueStatus @default(open)
  openedAt    DateTime                  @default(now())
  resolvedAt  DateTime?
  /// "auto" when the cause cleared by itself; otherwise the user who resolved it.
  resolvedBy  String?
  resolution  String?

  @@index([ownerId, status, openedAt])
  @@index([kind, subjectId, status])
}

// ---- Pay-per-citation: AI answers that pay the people whose work they cite ----------------

/// A prepaid balance, topped up with PayPal, that pays for answers.
/// balanceCents always equals the sum of the account's entries; reservedCents is held
/// for answers in progress (worst-case price), so concurrent answers can't overspend.
model CreditAccount {
  id            String   @id @default(cuid())
  ownerId       String   @unique
  owner         User     @relation(fields: [ownerId], references: [id])
  balanceCents  Int      @default(0)
  reservedCents Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  entries CreditEntry[]
  topUps  CreditTopUp[]
  answers Answer[]
}

/// Append-only ledger of a credit account.
model CreditEntry {
  id          String        @id @default(cuid())
  accountId   String
  account     CreditAccount @relation(fields: [accountId], references: [id])
  /// top_up | answer | top_up_reversal
  kind        String
  amountCents Int
  topUpId     String?
  answerId    String?
  /// A PayPal refund applied to a top-up: each refund is debited once, however often it is reported.
  refundId    String?       @unique
  createdAt   DateTime      @default(now())

  @@index([accountId, createdAt])
}

enum TopUpStatus {
  pending_payment
  captured
  payment_failed
  refunded
}

/// Money added to a credit account through a PayPal checkout. The id is also the
/// order's custom_id ("topup_…"), so PayPal webhooks find it.
model CreditTopUp {
  id               String        @id
  accountId        String
  account          CreditAccount @relation(fields: [accountId], references: [id])
  amountCents      Int
  currency         String        @default("USD")
  status           TopUpStatus   @default(pending_payment)
  orderId          String?       @unique
  captureId        String?       @unique
  /// What PayPal verifiably captured (credited), and how much of it was refunded since.
  creditedCents    Int           @default(0)
  refundedCents    Int           @default(0)
  /// Reconciliation: when to ask PayPal about this top-up next (null = nothing left to learn).
  nextCheckAt      DateTime?
  checkCount       Int           @default(0)
  checkLockedUntil DateTime?
  createdAt        DateTime      @default(now())
  capturedAt       DateTime?

  @@index([nextCheckAt])
}

enum AnswerStatus {
  answering
  answered
  not_covered
  failed
}

/// One question answered from a publisher's licensed library, with its signed receipt.
model Answer {
  id            String        @id @default(cuid())
  accountId     String
  account       CreditAccount @relation(fields: [accountId], references: [id])
  libraryId     String
  library       User          @relation("library", fields: [libraryId], references: [id])
  question      String
  /// The asker's mandate: the most this answer may cost. Enforced before the model runs.
  maxPriceCents Int
  /// Worst-case price held from the balance while answering.
  reservedCents Int           @default(0)
  status        AnswerStatus  @default(answering)
  /// { text, citations, unsupported, rejected } — see answers.service.
  content       Json?
  model         String?
  fromFixture   Boolean       @default(false)
  feeCents      Int           @default(0)
  chargedCents  Int           @default(0)
  /// Sources left out, and why (license, budget).
  excluded      Json          @default("[]")
  receipt       Json?
  signature     String?
  failureReason String?
  createdAt     DateTime      @default(now())
  finishedAt    DateTime?

  credits CitationCredit[]

  @@index([accountId, createdAt])
  @@index([libraryId, createdAt])
  @@index([status, createdAt])
}

enum CreditStatus {
  accrued
  in_payout
  paid
  /// Clawed back: the buyer's money behind it was refunded or charged back before it was paid out.
  reversed
}

/// What one contributor earned from one answer: verified citations × their rate.
model CitationCredit {
  id               String             @id @default(cuid())
  answerId         String
  answer           Answer             @relation(fields: [answerId], references: [id])
  libraryId        String
  contributorId    String
  contributor      User               @relation("creditContributor", fields: [contributorId], references: [id])
  assetVersionId   String
  assetTitle       String
  licenseId        String
  termsHash        String?
  centsPerCitation Int
  citations        Int
  amountCents      Int
  status           CreditStatus       @default(accrued)
  payoutItemId     String?
  payoutItem       RoyaltyPayoutItem? @relation(fields: [payoutItemId], references: [id])
  createdAt        DateTime           @default(now())

  @@index([libraryId, status])
  @@index([contributorId, createdAt])
}

/// A PayPal Payouts batch paying accrued answer royalties. senderBatchId is the
/// idempotency key: a resend after a lost response can never pay twice.
model RoyaltyPayout {
  id              String    @id @default(cuid())
  libraryId       String
  library         User      @relation(fields: [libraryId], references: [id])
  senderBatchId   String    @unique
  paypalBatchId   String?   @unique
  /// SUBMITTING | SUBMIT_FAILED | AWAITING_CONFIRMATION | REJECTED | PENDING | PROCESSING | SUCCESS | DENIED | CANCELED
  status          String
  totalCents      Int
  /// When the current send started (a send older than a few minutes was interrupted).
  sendingSince    DateTime?
  createdAt       DateTime  @default(now())
  lastCheckedAt   DateTime?
  /// Reconciliation: when to read the batch from PayPal next (null = final).
  nextPollAt      DateTime?
  pollCount       Int       @default(0)
  pollLockedUntil DateTime?

  items RoyaltyPayoutItem[]

  @@index([nextPollAt])
}

model RoyaltyPayoutItem {
  id            String        @id @default(cuid())
  payoutId      String
  payout        RoyaltyPayout @relation(fields: [payoutId], references: [id])
  senderItemId  String        @unique
  contributorId String
  receiver      String
  amountCents   Int
  status        String        @default("SUBMITTING")
  paypalItemId  String?
  transactionId String?
  errorName     String?

  credits CitationCredit[]
}
